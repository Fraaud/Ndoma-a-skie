# ---- Telegram ----
# Token del bot, da @BotFather
TELEGRAM_BOT_TOKEN=123456:AAAA-your-token-here
# URL pubblico della mini app (in locale: quello di ngrok/cloudflared).
# Telegram accetta solo https; se manca lo schema lo aggiunge il programma.
WEBAPP_URL=https://esempio.trycloudflare.com
# Chat/gruppo dove il bot pubblica le uscite (opzionale). Es. -1001234567890
TELEGRAM_GROUP_ID=

# ---- Fonti dati ----
# Skitour.fr: chiave gratuita dalla pagina di modifica del tuo profilo su skitour.fr
SKITOUR_API_KEY=
# openrouteservice: chiave gratuita su openrouteservice.org/dev/#/signup
# Senza, il percorso in auto e' una retta: i tempi di percorrenza non
# vengono mostrati e i paesi attraversati sono un'approssimazione. Con la
# chiave, ogni scheda gita dice "da Cuneo: 71 min" e il match sul corridoio
# stradale diventa preciso. Vale i due minuti che ci vogliono.
ORS_API_KEY=

# ---- Ambito geografico ----
# bbox = min_lon,min_lat,max_lon,max_lat
# Default: provincia di Cuneo + Mercantour/Alpes-Maritimes francesi
BBOX=6.55,44.00,7.95,44.75

# ---- Prova fuori stagione ----
# Un giorno d'inverno GIA' PASSATO da rigiocare sul prossimo weekend: l'app
# mostra meteo e bollettino veri di quel giorno, e lo dichiara in una fascia
# fissa in cima a ogni schermata. Vuoto = dati di oggi. Vedi app/simulazione.py
SIMULAZIONE_INVERNO=

# ---- Varie ----
# ATTENZIONE, in locale va bene cosi', ma NON copiare questo valore nelle
# variabili di un servizio in cloud: un percorso relativo punta dentro
# l'immagine, che a ogni deploy viene ricostruita, e ti ritrovi senza
# iscritti. In cloud lascialo vuoto (il database va da solo in DATA_DIR)
# oppure usa un percorso assoluto: sqlite:////data/ndoma.db (quattro barre).
DATABASE_URL=sqlite:///./data/ndoma.db
# Tile della mappa. Di default OpenTopoMap: ha le curve di livello e in
# montagna e' la differenza fra una mappa che si legge e una macchia verde.
# Licenza CC-BY-SA, attribuzione obbligatoria. La loro politica d'uso ammette
# pochi download al secondo: per un gruppo di amici va bene, per migliaia di
# utenti serve un servizio a pagamento (MapTiler, Thunderforest Outdoors).
# Lascia vuoto per usare i valori di default definiti in app/config.py.
TILE_URL=
TILE_ATTRIBUTION=
# User-Agent usato verso tutte le API esterne: mettici un contatto vero.
HTTP_USER_AGENT=ndoma-a-skie/0.1 (progetto no-profit; contatto: tua@email.it)
