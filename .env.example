# ---- Telegram ----
# Token del bot, da @BotFather
TELEGRAM_BOT_TOKEN=123456:AAAA-your-token-here
# URL pubblico della mini app (in locale: quello che ti d� ngrok/cloudflared)
WEBAPP_URL=https://esempio.trycloudflare.com
# Chat/gruppo dove il bot pubblica le uscite (opzionale). Es. -1001234567890
TELEGRAM_GROUP_ID=

# ---- Fonti dati ----
# Skitour.fr: chiave gratuita dalla pagina di modifica del tuo profilo su skitour.fr
SKITOUR_API_KEY=
# openrouteservice: chiave gratuita su openrouteservice.org/dev/#/signup
ORS_API_KEY=

# ---- Ambito geografico ----
# bbox = min_lon,min_lat,max_lon,max_lat
# Default: provincia di Cuneo + Mercantour/Alpes-Maritimes francesi
BBOX=6.55,44.00,7.95,44.75

# ---- Varie ----
DATABASE_URL=sqlite:///./data/ndoma.db
# Tile server per la mappa. Di default OSM standard: va bene per poche decine
# di utenti, ma leggi la tile usage policy. Per crescere: MapTiler o
# Thunderforest Outdoors (tier gratuiti) o OpenTopoMap.
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# User-Agent usato verso tutte le API esterne: mettici un contatto vero.
HTTP_USER_AGENT=ndoma-a-skie/0.1 (progetto no-profit; contatto: tua@email.it)
